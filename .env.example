# npm run setup:matrix generates these in a private .env automatically.
# For an existing homeserver, fill in its URL and your own device access token locally.
MATRIX_HOMESERVER=http://127.0.0.1:8008
MATRIX_ACCESS_TOKEN=
MATRIX_DEVICE_ID=
MATRIX_USER_ID=@personal:nav.local
MATRIX_BRIDGE_BOT=@whatsappbot:nav.local
MATRIX_BRIDGE_COMMAND_PREFIX=!wa
PORT=3000

# Local video conversion (optional paths when these binaries are not on PATH).
# FFMPEG_PATH=/path/to/ffmpeg
# FFPROBE_PATH=/path/to/ffprobe

# Optional Source provider credentials. These can also be saved privately in Sources → Manage.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# X_BEARER_TOKEN=
# BANDSINTOWN_APP_ID=
# SAUCENAO_API_KEY=
